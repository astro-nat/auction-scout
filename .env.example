# Copy this file to .env and fill in real values. .env is gitignored — never commit real keys.

DATABASE_URL=postgresql+psycopg2://htown:devpassword@localhost:5432/auction_scout

# Required — Claude enrichment (text + vision) in the worker
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional — eBay Browse API for price comps + image search (empty = feature off)
EBAY_APP_ID=
EBAY_CERT_ID=

# Optional — SoldComps API for real sold prices (empty = active-listing comps only)
SOLDCOMPS_API_KEY=

# Pricing realism. Active eBay listings are ASKING prices, often for new
# stock — realized sale prices run lower. 0.65 = assume items sell for ~65%
# of asking; 1.0 disables. Ignored when SOLDCOMPS_API_KEY is set, since
# those are already real sold prices.
ACTIVE_REALIZATION=0.65

# Sourcing defaults (override per-scan via the API)
SOURCING_ZIP=77058
SOURCING_RADIUS_MILES=20
CLOSING_WITHIN_DAYS=7
